ARG PPAP_WORKER_IMAGE=ppap-worker:unknown
FROM ${PPAP_WORKER_IMAGE}

WORKDIR /workspace

COPY pyproject.toml /workspace/pyproject.toml
COPY --from=psw-tests . /workspace/tests
COPY --from=psw-assets . /workspace/assets/V2.0测试/模拟测试文件V2-01/16-零件提交保证书

RUN python -m pip install --no-cache-dir pytest==7.4.3 pytest-asyncio==0.21.1 \
 && command -v soffice \
 && command -v ppap-local-converter-sandbox

ENV PYTHONPATH=
ENTRYPOINT []
CMD ["pytest", "tests/corpus/test_psw_cross_format_regression.py", "tests/corpus/test_psw_cross_format_audit.py", "-q"]
