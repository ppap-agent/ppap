ARG PPAP_WORKER_IMAGE=ppap-worker:unknown
FROM ${PPAP_WORKER_IMAGE}

COPY --from=ghcr.io/astral-sh/uv:0.9.26@sha256:9a23023be68b2ed09750ae636228e903a54a05ea56ed03a934d00fe9fbeded4b /uv /bin/uv

WORKDIR /workspace

COPY pyproject.toml /workspace/pyproject.toml
COPY --from=psw-tests corpus/contracts /app/tests/corpus/contracts
COPY --from=psw-tests . /workspace/tests
COPY --from=psw-assets . /workspace/assets/理想/样本/模拟测试文件V2-01/16-零件提交保证书

# The worker image is the locked production install (`--no-dev --no-editable`).
# PSW needs the default dev dependency group from that same lock.
RUN UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1 \
    uv sync --project /app --frozen --no-editable \
 && command -v soffice \
 && command -v ppap-local-converter-sandbox

ENTRYPOINT []
CMD ["pytest", "tests/corpus/psw", "-q"]
