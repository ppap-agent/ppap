# Settings defaults for local/dev. Copy secrets into gitignored `.env`.
# Production catalog is `.env.production`; do not reuse isolated-dev
# passwords, S3 loopback, or loopback Web/API URLs. Empty values are unset.
# .doc conversion is always on; there is no LEGACY_DOC_CONVERSION_ENABLED.

PPAP_PROFILE=isolated-dev
PPAP_WEB_URL=http://127.0.0.1:4173
PPAP_PUBLIC_API_URL=http://127.0.0.1:8080
PPAP_WEB_BIND=127.0.0.1
PPAP_WEB_PORT=4173
PPAP_API_BIND=127.0.0.1
PPAP_API_PORT=8080

PPAP_SUPPORT_PHONE=
PPAP_SUPPORT_EMAIL=
PPAP_SUPPORT_SERVICE_HOURS=
PPAP_SUPPORT_QR_FILE=

LLM_API_KEY=
LLM_BASE_URL=https://grok.trustedtunnel.app/v1
LLM_MODEL=grok-4.6
OPENAI_REASONING_EFFORT=low

FEISHU_APP_ID=
PPAP_FEISHU_NOTIFICATIONS_ENABLED=false
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_AI_ITEM_ID=
FEISHU_FREE_TRIAL_QUOTA_POINTS=10000

PPAP_PG_HOST=127.0.0.1
PPAP_PG_PORT=5432
PPAP_PG_DATABASE=ppap
PPAP_PG_BOOTSTRAP_USER=ppap
PPAP_PG_BOOTSTRAP_PASSWORD=ppap_isolated_dev
PPAP_PG_MIGRATOR_USER=ppap_migrator
PPAP_PG_MIGRATOR_PASSWORD=ppap_isolated_dev
PPAP_PG_API_USER=ppap_api
PPAP_PG_API_PASSWORD=ppap_isolated_dev
PPAP_PG_WORKER_USER=ppap_worker
PPAP_PG_WORKER_PASSWORD=ppap_isolated_dev

PPAP_S3_ENDPOINT=http://127.0.0.1:9000
PPAP_S3_REGION=us-east-1
PPAP_S3_BUCKET=ppap-objects
PPAP_S3_ACCESS_KEY=ppap_isolated_dev
PPAP_S3_SECRET_KEY=ppap_isolated_dev

LOG_LEVEL=INFO
LOG_FORMAT=text

OCR_OPENAI_API_KEY=
OCR_OPENAI_BASE_URL=
OCR_MODEL_NAME=
OCR_OPENAI_EXTRA_BODY_JSON=
PADDLE_OCR_URL=
PADDLE_TOKEN=

# Optional Deep controller UDS. Core starts without this; Deep rounds fail instead of falling back to Standard.
PPAP_DEEP_CONTROLLER_SOCKET=
PPAP_DEEP_EXECUTOR_REVISION=
PPAP_DEEP_SANDBOX_PROFILE=off

PPAP_CURRENT_TENANT_ALLOWLIST=
PPAP_USAGE_CHARGE_ENABLED=true
PPAP_MCP_ENABLED=false
PPAP_MCP_ALLOWED_ORIGINS=[]

# Optional complete Deep-only model override (Pi Responses endpoint).
PPAP_DEEP_LLM_BASE_URL=
PPAP_DEEP_LLM_MODEL=
PPAP_DEEP_LLM_API_KEY=
PPAP_DEEP_REASONING_EFFORT=medium

# Personal model credential encryption, injected through deployment Secret.
PPAP_MODEL_CREDENTIAL_ENCRYPTION_KEY=
