# Canonical deploy uses this catalog after secrets are filled:
#   docker compose -f deploy/compose.yaml --env-file .env up -d --wait
# CI still uses deploy/compose.env.example unless --env-file is set.

PPAP_PROFILE=production
PPAP_WEB_URL=
PPAP_PUBLIC_API_URL=
PPAP_WEB_BIND=127.0.0.1
PPAP_WEB_PORT=4173
PPAP_API_BIND=127.0.0.1
PPAP_API_PORT=8080

PPAP_SUPPORT_PHONE=
PPAP_SUPPORT_EMAIL=
PPAP_SUPPORT_SERVICE_HOURS=
PPAP_SUPPORT_QR_FILE=

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Set explicitly for reasoning models; leave empty when the provider does not support it.
OPENAI_REASONING_EFFORT=low

FEISHU_APP_ID=
PPAP_FEISHU_NOTIFICATIONS_ENABLED=false
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_AI_ITEM_ID=
FEISHU_FREE_TRIAL_QUOTA_POINTS=10000

PPAP_PG_HOST=
PPAP_PG_PORT=5432
PPAP_PG_DATABASE=ppap
PPAP_PG_BOOTSTRAP_USER=ppap
PPAP_PG_BOOTSTRAP_PASSWORD=
PPAP_PG_MIGRATOR_USER=ppap_migrator
PPAP_PG_MIGRATOR_PASSWORD=
PPAP_PG_API_USER=ppap_api
PPAP_PG_API_PASSWORD=
PPAP_PG_WORKER_USER=ppap_worker
PPAP_PG_WORKER_PASSWORD=

PPAP_S3_ENDPOINT=
PPAP_S3_REGION=us-east-1
PPAP_S3_BUCKET=ppap-objects
PPAP_S3_ACCESS_KEY=
PPAP_S3_SECRET_KEY=

LOG_LEVEL=INFO
LOG_FORMAT=text

OCR_OPENAI_API_KEY=
OCR_OPENAI_BASE_URL=
OCR_MODEL_NAME=
OCR_OPENAI_EXTRA_BODY_JSON=
PADDLE_OCR_URL=
PADDLE_TOKEN=

# Optional Deep controller UDS. Core starts without this; Deep rounds fail instead of falling back to Standard.
# Production does not offer Deep to customers until a real executor is accepted (#78).
PPAP_DEEP_CONTROLLER_SOCKET=
PPAP_DEEP_EXECUTOR_REVISION=
PPAP_DEEP_SANDBOX_PROFILE=off
PPAP_DEEP_CUSTOMER_ENABLED=false

# Preview cut-over: only coastline Feishu tenants; current path does not charge.
PPAP_CURRENT_TENANT_ALLOWLIST=2caeb428f08e175d,16e7179eb1abd75d,16fad24b7282175e,175b8362d5ce575f
PPAP_USAGE_CHARGE_ENABLED=false
PPAP_MCP_ENABLED=false
PPAP_MCP_ALLOWED_ORIGINS=[]

# Optional complete Deep-only model override (Pi Responses endpoint).
PPAP_DEEP_LLM_BASE_URL=
PPAP_DEEP_LLM_MODEL=
PPAP_DEEP_LLM_API_KEY=
PPAP_DEEP_REASONING_EFFORT=medium
