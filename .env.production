# Canonical deploy uses this catalog after secrets are filled:
#   docker compose -f deploy/compose.yaml --env-file .env up -d --wait
# CI still uses deploy/compose.env.example unless --env-file is set.

PPAP_PROFILE=production
PPAP_WEB_URL=
PPAP_PUBLIC_API_URL=
PPAP_WEB_BIND=127.0.0.1
PPAP_WEB_PORT=4173
PPAP_API_BIND=127.0.0.1
PPAP_API_PORT=8080

PPAP_SUPPORT_PHONE=
PPAP_SUPPORT_EMAIL=
PPAP_SUPPORT_SERVICE_HOURS=
PPAP_SUPPORT_QR_FILE=

PPAP_MODEL_TEXT_API_KEY=
PPAP_MODEL_TEXT_BASE_URL=
PPAP_MODEL_TEXT_MODEL=
# Set explicitly for reasoning models; leave empty when the provider does not support it.
PPAP_MODEL_TEXT_REASONING_EFFORT=low

FEISHU_APP_ID=
PPAP_FEISHU_NOTIFICATIONS_ENABLED=false
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_AI_ITEM_ID=
FEISHU_FREE_TRIAL_QUOTA_POINTS=10000

PPAP_PG_HOST=
PPAP_PG_PORT=5432
PPAP_PG_DATABASE=ppap
PPAP_PG_BOOTSTRAP_USER=ppap
PPAP_PG_BOOTSTRAP_PASSWORD=
PPAP_PG_MIGRATOR_USER=ppap_migrator
PPAP_PG_MIGRATOR_PASSWORD=
PPAP_PG_API_USER=ppap_api
PPAP_PG_API_PASSWORD=
PPAP_PG_WORKER_USER=ppap_worker
PPAP_PG_WORKER_PASSWORD=

PPAP_S3_ENDPOINT=
PPAP_S3_REGION=us-east-1
PPAP_S3_BUCKET=ppap-objects
PPAP_S3_ACCESS_KEY=
PPAP_S3_SECRET_KEY=

LOG_LEVEL=INFO
LOG_FORMAT=text

PPAP_MODEL_VISION_API_KEY=
PPAP_MODEL_VISION_BASE_URL=
PPAP_MODEL_VISION_MODEL=
PPAP_MODEL_VISION_EXTRA_BODY_JSON=
PPAP_PADDLE_URL=
PPAP_PADDLE_TOKEN=

# Optional Deep controller UDS. Without it the P3 deep-mode switch is off and deep tasks are not accepted.
# Deep runtime serves audit execution; customer rule checkers are prepared offline by the platform.
PPAP_DEEP_CONTROLLER_SOCKET=
PPAP_DEEP_EXECUTOR_REVISION=
PPAP_DEEP_SANDBOX_PROFILE=off

# Preview cut-over: only coastline Feishu tenants; current path does not charge.
PPAP_CURRENT_TENANT_ALLOWLIST=2caeb428f08e175d,16e7179eb1abd75d,16fad24b7282175e,175b8362d5ce575f
PPAP_USAGE_CHARGE_ENABLED=false
PPAP_MCP_ENABLED=false
PPAP_MCP_ALLOWED_ORIGINS=[]

# Coding (the Deep agent, Pi). Without its own base URL and model it uses the text model.
PPAP_MODEL_CODING_BASE_URL=
PPAP_MODEL_CODING_MODEL=
PPAP_MODEL_CODING_API_KEY=
PPAP_MODEL_CODING_REASONING_EFFORT=medium

# Tenant model keys (tenant BYOK): trusted endpoints, and the Deep request limit. The encryption key comes from a deployment Secret.
PPAP_TENANT_MODEL_ALLOWED_BASE_URLS=
PPAP_DEEP_MODEL_MAX_REQUESTS=200
PPAP_MODEL_CREDENTIAL_ENCRYPTION_KEY=
