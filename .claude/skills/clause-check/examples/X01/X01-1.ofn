Prefix(:=<https://ppap.example/rules/X01#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(<https://ppap.example/rules/X01/1>
  # 虚构条款 X01:1 的完整示例。运行：python3 <技能目录>/scripts/check.py <技能目录>/examples/X01/X01-1.ofn
  Annotation(:clause "X01/rules.json#X01:1")
  Declaration(AnnotationProperty(:clause)) Declaration(AnnotationProperty(:quote))
  Declaration(AnnotationProperty(:limit)) Declaration(AnnotationProperty(:open))
  Declaration(AnnotationProperty(:issue)) Declaration(AnnotationProperty(:question))
  Declaration(AnnotationProperty(:says)) Declaration(AnnotationProperty(:contradiction))
  Declaration(AnnotationProperty(:case)) Declaration(AnnotationProperty(:truth))
  Declaration(ObjectProperty(:hasRole))

  # 词汇：文件、签字栏里的角色、签名方式（穷尽）、日期
  Declaration(Class(:File)) Declaration(Class(:RoleEntry))
  Declaration(Class(:Author)) Declaration(Class(:Reviewer)) Declaration(Class(:Approver))
  SubClassOf(:Author :RoleEntry) SubClassOf(:Reviewer :RoleEntry) SubClassOf(:Approver :RoleEntry)
  Declaration(Class(:HandSignature)) Declaration(Class(:ElectronicSignature)) Declaration(Class(:NoSignature))
  DisjointUnion(:RoleEntry :HandSignature :ElectronicSignature :NoSignature)
  Declaration(Class(:HasDate))

  Declaration(Class(:HasSignatureBlock))
  AnnotationAssertion(Annotation(:limit "open-world")
    Annotation(:says "判断“签字栏不存在”时，要能确认封面上确实没有签字栏，才能判不通过。")
    :quote :HasSignatureBlock "签字栏不存在则不通过")

  # 写不出的比较：批准日期不早于编制日期。抽象成三个互斥且穷尽的类，原文没定义的情况写成 :open
  Declaration(Class(:ApprovedInOrder)) Declaration(Class(:ApprovedEarly)) Declaration(Class(:DatesNotComparable))
  DisjointUnion(:File :ApprovedInOrder :ApprovedEarly :DatesNotComparable)
  AnnotationAssertion(Annotation(:limit "predicate")
    Annotation(:open "日期只写到月份（如“2024.05”）时，“不得早于”怎么比较？")
    :quote :ApprovedInOrder "批准日期不得早于编制日期")

  # 判定：只引用歧义点 :Signed
  Declaration(Class(:Pass)) Declaration(Class(:Fail)) DisjointClasses(:Pass :Fail)
  Declaration(Class(:Signed)) Declaration(Class(:RoleOK))
  EquivalentClasses(:RoleOK ObjectIntersectionOf(:Signed :HasDate))
  EquivalentClasses(Annotation(:quote "识别封面签字栏中编制、审核、批准是否都已签名并填写日期") :Pass
    ObjectIntersectionOf(:File :HasSignatureBlock :ApprovedInOrder
      ObjectSomeValuesFrom(:hasRole :Author) ObjectSomeValuesFrom(:hasRole :Reviewer) ObjectSomeValuesFrom(:hasRole :Approver)
      ObjectAllValuesFrom(:hasRole :RoleOK)))
  EquivalentClasses(Annotation(:quote "任一为空则不通过") :Fail
    ObjectIntersectionOf(:File ObjectUnionOf(ObjectComplementOf(:HasSignatureBlock) :ApprovedEarly
      ObjectComplementOf(ObjectSomeValuesFrom(:hasRole :Author)) ObjectComplementOf(ObjectSomeValuesFrom(:hasRole :Reviewer))
      ObjectComplementOf(ObjectSomeValuesFrom(:hasRole :Approver)) ObjectSomeValuesFrom(:hasRole ObjectComplementOf(:RoleOK)))))
  AnnotationAssertion(Annotation(:limit "output") Annotation(:says "判定不通过时，提示用户补签。") :quote :Fail "并提示用户补签")

  # 歧义 1：“已签名”包括哪些签法
  AnnotationAssertion(:issue :Signed "“已签名”包括哪些签法")
  AnnotationAssertion(:question :Signed "电子签名算不算“已签名”？")
  Declaration(Class(:Signed__1A)) Declaration(Class(:Signed__1B))
  AnnotationAssertion(rdfs:label :Signed__1A "手写或电子都算")
  AnnotationAssertion(:says :Signed__1A "手写签名和电子签名都算已签名。")
  AnnotationAssertion(rdfs:label :Signed__1B "只认手写签名")
  AnnotationAssertion(:says :Signed__1B "只有手写签名才算已签名。")
  EquivalentClasses(:Signed__1A ObjectUnionOf(:HandSignature :ElectronicSignature))
  EquivalentClasses(:Signed__1B :HandSignature)

  # 歧义 1 的例子：一份具体文件，事实写封闭，两种理解在它上面必须结论相反
  Declaration(Class(:Example__1))
  AnnotationAssertion(:says :Example__1 "签字栏三栏都有日期，编制、审核是手写签名，批准是电子签名，批准日期不早于编制日期。")
  EquivalentClasses(:Example__1 ObjectIntersectionOf(:File :HasSignatureBlock :ApprovedInOrder
    ObjectSomeValuesFrom(:hasRole ObjectIntersectionOf(:Author :HandSignature :HasDate))
    ObjectSomeValuesFrom(:hasRole ObjectIntersectionOf(:Reviewer :HandSignature :HasDate))
    ObjectSomeValuesFrom(:hasRole ObjectIntersectionOf(:Approver :ElectronicSignature :HasDate))
    ObjectAllValuesFrom(:hasRole ObjectIntersectionOf(:HasDate ObjectUnionOf(:HandSignature :ElectronicSignature)))))

  # 缺口：日期没法比较、签字都齐全的文件
  Declaration(Class(:Probe_DatesUnclear))
  AnnotationAssertion(:says :Probe_DatesUnclear "批准日期和编制日期没法比较、签字都齐全的文件")
  EquivalentClasses(:Probe_DatesUnclear ObjectIntersectionOf(:File :DatesNotComparable :HasSignatureBlock
    ObjectComplementOf(:Pass) ObjectComplementOf(:Fail)))

  # 真实文件（虚构）：三栏手写签名、都有日期
  Declaration(Class(:CaseCover1))
  AnnotationAssertion(:case :CaseCover1 "封面-样例.pdf") AnnotationAssertion(:truth :CaseCover1 "PASS")
  EquivalentClasses(:CaseCover1 ObjectIntersectionOf(:File :HasSignatureBlock :ApprovedInOrder
    ObjectSomeValuesFrom(:hasRole ObjectIntersectionOf(:Author :HandSignature :HasDate))
    ObjectSomeValuesFrom(:hasRole ObjectIntersectionOf(:Reviewer :HandSignature :HasDate))
    ObjectSomeValuesFrom(:hasRole ObjectIntersectionOf(:Approver :HandSignature :HasDate))
    ObjectAllValuesFrom(:hasRole ObjectIntersectionOf(:HandSignature :HasDate))))
)
