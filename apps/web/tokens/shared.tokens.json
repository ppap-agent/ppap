{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Inter",
        "-apple-system",
        "BlinkMacSystemFont",
        "PingFang SC",
        "Hiragino Sans GB",
        "Microsoft YaHei",
        "Noto Sans SC",
        "Segoe UI",
        "sans-serif"
      ]
    },
    "size-dense": {
      "$type": "dimension",
      "$value": {
        "value": 13,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "control": {
      "$type": "dimension",
      "$value": {
        "value": 0.5,
        "unit": "rem"
      }
    }
  }
}
