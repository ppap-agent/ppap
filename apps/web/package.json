{
  "name": "ppap-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint:design": "node scripts/design-lint.mjs && node scripts/a11y-contract.mjs",
    "test": "node --experimental-strip-types --test src/navigation/route.test.ts src/workflow/ruleImport.test.ts src/workflow/submission.test.ts src/ui/contrast.test.ts scripts/design-lint.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
