{
  "name": "ppap-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "vite",
    "preview:workbench": "PPAP_PREVIEW=1 vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:css": "node scripts/build-tokens.ts && stylelint \"src/**/*.css\"",
    "tokens": "node scripts/build-tokens.ts",
    "design:update": "node scripts/design-document.ts update ../../design.md",
    "design:check": "node scripts/design-document.ts check ../../design.md",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "api-types": "( cd ../.. && uv run --no-sync python -c \"import json; from api import app; print(json.dumps(app.openapi(), ensure_ascii=False, sort_keys=True))\" ) | pnpm exec openapi-typescript --alphabetize -o src/generated/openapi.ts",
    "api-types:check": "( cd ../.. && uv run --no-sync python -c \"import json; from api import app; print(json.dumps(app.openapi(), ensure_ascii=False, sort_keys=True))\" ) | pnpm exec openapi-typescript --alphabetize --check -o src/generated/openapi.ts"
  },
  "dependencies": {
    "@lark-opdev/block-docs-addon-api": "0.0.11",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-resizable-panels": "^4.13.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@shadcn/lint": "^0.2.0",
    "@terrazzo/parser": "2.10.0",
    "@terrazzo/plugin-css": "2.10.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "5.0.4",
    "docx-preview": "0.4.1",
    "eslint": "^10.11.0",
    "fflate": "^0.8.3",
    "openapi-typescript": "7.13.0",
    "pdfjs-dist": "6.4.299",
    "shadcn": "^4.21.0",
    "stylelint": "17.16.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
