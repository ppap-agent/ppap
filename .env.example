# PPAP application configuration.
# Canonical field semantics are owned by typed Settings.
# Isolated-dev defaults: `.env.dev`; deployed values: `deploy/tke/current.yaml`.
# Put secrets here and copy to gitignored `.env`.

# Platform models, one group per use: PPAP_MODEL_<TEXT|VISION|CODING>_*. Text base URL/model have isolated-dev defaults; production sets them.
PPAP_MODEL_TEXT_API_KEY=
PPAP_MODEL_TEXT_BASE_URL=
PPAP_MODEL_TEXT_MODEL=
# Leave empty for models without reasoning support.
PPAP_MODEL_TEXT_REASONING_EFFORT=low

# Optional Feishu capability. Core starts without these.
FEISHU_APP_ID=
PPAP_FEISHU_NOTIFICATIONS_ENABLED=false
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_AI_ITEM_ID=
# Feishu's usage reconciliation query: Ed25519 seed (base64) that signs answers; caller key when agreed; legacy UAC's query.
PPAP_FEISHU_USAGE_SEARCH_SIGNING_KEY=
PPAP_FEISHU_USAGE_SEARCH_API_KEY=
PPAP_LEGACY_USAGE_SEARCH_URL=
# Trial cap used only for remaining_trial_ai_points. Paid Partner AI balance is not estimated locally.
FEISHU_FREE_TRIAL_QUOTA_POINTS=10000
# Optional per-tenant trial points, JSON of Feishu tenant key to points; unlisted tenants get the amount above.
FEISHU_TRIAL_QUOTA_OVERRIDES={}

# Canonical public Web origin used by CORS and OAuth return_to.
PPAP_WEB_URL=http://127.0.0.1:4173

# Confirmed public support details only. The QR path is inside the API runtime.
PPAP_SUPPORT_PHONE=
PPAP_SUPPORT_EMAIL=
PPAP_SUPPORT_SERVICE_HOURS=
PPAP_SUPPORT_QR_FILE=

# Optional read-only OnlyOffice Document Server (no Java adapter).
# Browser-facing Document Server URL, and API URL reachable from that server.
PPAP_ONLYOFFICE_URL=
PPAP_ONLYOFFICE_API_URL=
# Match Document Server JWT_SECRET; use at least 32 random characters.
PPAP_ONLYOFFICE_SECRET=

# Isolated-dev PostgreSQL/object-storage defaults live in Settings.
# Override PPAP_PG_* / PPAP_S3_* only when the defaults cannot apply.

# Deep controller UDS. Core starts without it, but standard and deep audits then fail explicitly.
PPAP_DEEP_CONTROLLER_SOCKET=
# Optional policy label; acceptance derives the full effective configuration digest.
PPAP_DEEP_EXECUTOR_REVISION=
PPAP_DEEP_SANDBOX_PROFILE=off

# Released Feishu tenant keys; empty is open.
PPAP_CURRENT_TENANT_ALLOWLIST=
PPAP_USAGE_CHARGE_ENABLED=true
PPAP_MCP_ENABLED=false
# Platform operators (comma-separated Feishu `tenant_key:open_id`): the only identities that upload/publish rules
# or adopt checker versions. Empty = nobody. Unset under isolated-dev = the fixtures alice and carol.
PPAP_PLATFORM_OPERATORS=
# People commissioned to prepare rule clarifications in an enterprise (same format). They cannot send or confirm.
PPAP_CLAUSE_REVIEWERS=
PPAP_MCP_ALLOWED_ORIGINS=[]
# Feishu Project (Meego) plugin host. Off unless the plugin ID, secret and tenant map are all set.
# The map is explicit: Meego saas_tenant_key -> Feishu tenant_key of the same enterprise.
PPAP_MEEGO_PLUGIN_ID=
PPAP_MEEGO_PLUGIN_SECRET=
PPAP_MEEGO_TENANT_MAP={}
# Optional AI node app (a separate Feishu Project app): webhook token and its own credentials.
PPAP_MEEGO_AI_NODE_PLUGIN_ID=
PPAP_MEEGO_AI_NODE_TOKEN=
PPAP_MEEGO_AI_NODE_PLUGIN_SECRET=
# Plugin pages run on this origin; it is added to CORS only while the plugin host is on.
PPAP_MEEGO_PLUGIN_ORIGINS=["https://projectplg.feishupkg.com"]

# Coding (the Deep agent, Pi); fallback rules: deploy/deep/README.md.
PPAP_MODEL_CODING_BASE_URL=
PPAP_MODEL_CODING_MODEL=
PPAP_MODEL_CODING_API_KEY=
PPAP_MODEL_CODING_REASONING_EFFORT=medium

# Vision (LLM OCR) uses its own model and credentials and never borrows the text model.
PPAP_MODEL_VISION_API_KEY=
PPAP_MODEL_VISION_BASE_URL=
PPAP_MODEL_VISION_MODEL=
# Sent as reasoning.effort; the model must accept it (none turns reasoning off).
PPAP_MODEL_VISION_REASONING_EFFORT=none

# Fernet encryption key for a tenant's own model key (tenant BYOK). No plaintext/default key.
# Inject through deployment Secrets into API, Worker and trusted Controller only.
PPAP_DEEP_REVIEW_SECONDS=600
# Files of one deep round reviewed side by side (1-8); the model gateway sends as many requests at once.
PPAP_DEEP_REVIEW_CONCURRENCY=1
# Exact trusted HTTPS prefixes for tenant model keys, comma-separated; no wildcards.
PPAP_TENANT_MODEL_ALLOWED_BASE_URLS=
PPAP_MODEL_CREDENTIAL_ENCRYPTION_KEY=
