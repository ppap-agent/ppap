# PPAP core configuration contract.
# The target application is still being implemented by #2; these names are the canonical runtime contract.
#
# Core audit requires one secret plus two explicit OpenAI-compatible settings.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional Feishu integration. Core PPAP must start without these.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Core infrastructure intentionally has committed isolated-development defaults
# (PostgreSQL + S3-compatible object storage) and therefore is not required here.
# Production credentials belong in the deployment secret/config system, not this file.
#
# Do not add OPENAI_API_KEY / OPENAI_BASE_URL / MODEL_NAME as permanent aliases.
# Existing cloud-agent variables with those names should be renamed/mapped once to LLM_*.

# Live product verification configuration. These are not application startup requirements.
PPAP_ENVIRONMENT=isolated-dev
PPAP_WEB_URL=
PPAP_BUILD_SHA=
PPAP_AUTH_STATE=.local/auth.json
PPAP_OTHER_TENANT_STATE=.local/other-tenant-auth.json
PPAP_SAMPLE=
PPAP_ORACLE=.local/oracle.json
PPAP_EXISTING_ROUND_URL=
PPAP_REPLACEMENT_SAMPLE=
PPAP_LIVE_TIMEOUT_SECONDS=300
PPAP_VERSION_URL=

# Optional migration-only legacy engine verification. Never a final core dependency.
PPAP_LEGACY_ENGINE_URL=
PPAP_LEGACY_VERSION_URL=
PPAP_LEGACY_ENGINE_TOKEN=
PPAP_LEGACY_PROJECT_ID=
PPAP_LIVE_SOURCE_URL=
