# PPAP application configuration.
# Canonical field semantics are owned by typed Settings.
# Full default catalogs: `.env.dev` and `.env.production`.
# Put secrets here and copy to gitignored `.env`.

# Core LLM. Base URL/model have isolated-dev defaults in Settings; production should set its actual values.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional Feishu capability. Core starts without these.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_AI_ITEM_ID=
# Trial cap used only for remaining_trial_ai_points. Paid Partner AI balance is not estimated locally.
FEISHU_FREE_TRIAL_QUOTA_POINTS=10000

# Canonical public Web origin used by CORS and OAuth return_to.
PPAP_WEB_URL=http://127.0.0.1:4173

# Isolated-dev PostgreSQL/object-storage defaults live in Settings.
# Override PPAP_PG_* / PPAP_S3_* only when the defaults cannot apply.
