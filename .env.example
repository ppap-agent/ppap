# PPAP application configuration.
# Canonical field semantics are owned by typed Settings.
# Full default catalogs: `.env.dev` and `.env.production`.
# Put secrets here and copy to gitignored `.env`.

# Core LLM. Base URL/model have isolated-dev defaults in Settings; production should set its actual values.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional Feishu capability. Core starts without these.
FEISHU_APP_ID=
PPAP_FEISHU_NOTIFICATIONS_ENABLED=false
PPAP_FEISHU_FEEDBACK_BASE_TOKEN=
PPAP_FEISHU_FEEDBACK_TABLE_ID=
PPAP_FEISHU_FEEDBACK_TENANT_KEY=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_AI_ITEM_ID=
# Trial cap used only for remaining_trial_ai_points. Paid Partner AI balance is not estimated locally.
FEISHU_FREE_TRIAL_QUOTA_POINTS=10000

# Canonical public Web origin used by CORS and OAuth return_to.
PPAP_WEB_URL=http://127.0.0.1:4173

# Confirmed public support details only. The QR path is inside the API runtime.
PPAP_SUPPORT_PHONE=
PPAP_SUPPORT_EMAIL=
PPAP_SUPPORT_SERVICE_HOURS=
PPAP_SUPPORT_QR_FILE=

# Optional read-only OnlyOffice Document Server (no Java adapter).
# Browser-facing Document Server URL, and API URL reachable from that server.
PPAP_ONLYOFFICE_URL=
PPAP_ONLYOFFICE_API_URL=
# Match Document Server JWT_SECRET; use at least 32 random characters.
PPAP_ONLYOFFICE_SECRET=

# Isolated-dev PostgreSQL/object-storage defaults live in Settings.
# Override PPAP_PG_* / PPAP_S3_* only when the defaults cannot apply.

# Optional Deep controller UDS. Core starts without this.
# Production keeps Deep hidden unless a real executor is accepted (#78).
PPAP_DEEP_CONTROLLER_SOCKET=
PPAP_DEEP_EXECUTOR_REVISION=
PPAP_DEEP_CUSTOMER_ENABLED=false

# Empty allowlist is open. Production catalog lists coastline tenant keys.
PPAP_CURRENT_TENANT_ALLOWLIST=
PPAP_USAGE_CHARGE_ENABLED=true
