# Verification fixture for `docker compose -f deploy/compose.yaml --env-file`.
# Not isolated-dev credentials, and not a production secret store.
PPAP_PROFILE=production
PPAP_PG_HOST=postgres
PPAP_PG_PORT=5432
PPAP_PG_DATABASE=ppap
PPAP_PG_BOOTSTRAP_USER=ppap
PPAP_PG_BOOTSTRAP_PASSWORD=ppap_compose_verify
PPAP_PG_MIGRATOR_USER=ppap_migrator
PPAP_PG_MIGRATOR_PASSWORD=ppap_compose_verify
PPAP_PG_API_USER=ppap_api
PPAP_PG_API_PASSWORD=ppap_compose_verify
PPAP_PG_WORKER_USER=ppap_worker
PPAP_PG_WORKER_PASSWORD=ppap_compose_verify
PPAP_S3_ENDPOINT=http://silo:9000
PPAP_S3_REGION=us-east-1
PPAP_S3_BUCKET=ppap-objects
PPAP_S3_ACCESS_KEY=ppap_compose_verify
PPAP_S3_SECRET_KEY=ppap_compose_verify
PPAP_WEB_URL=http://127.0.0.1:4173
PPAP_PUBLIC_API_URL=http://127.0.0.1:8080
PPAP_WEB_BIND=0.0.0.0
PPAP_MODEL_TEXT_BASE_URL=http://llm.invalid/v1
PPAP_MODEL_TEXT_MODEL=compose-verify
PPAP_MODEL_TEXT_API_KEY=
LOG_FORMAT=json
LOG_LEVEL=INFO
PPAP_DEEP_CONTROLLER_SOCKET=
PPAP_DEEP_EXECUTOR_REVISION=
PPAP_DEEP_SANDBOX_PROFILE=off
PPAP_CURRENT_TENANT_ALLOWLIST=
PPAP_USAGE_CHARGE_ENABLED=true
