{
  "name": "ppap-api",
  "kind": "custom-compute",
  "image": "ppap-api:${PPAP_BUILD_SHA}",
  "port": 8080,
  "protocol": "http",
  "memory_mb": 1024,
  "ingress": "port",
  "environment": {
    "PPAP_PROFILE": "production",
    "PPAP_BUILD_SHA": "${PPAP_BUILD_SHA}",
    "PPAP_SERVICE": "api",
    "PPAP_PG_HOST": "${PPAP_PG_HOST}",
    "PPAP_PG_PORT": "${PPAP_PG_PORT}",
    "PPAP_PG_DATABASE": "${PPAP_PG_DATABASE}",
    "PPAP_PG_API_USER": "${PPAP_PG_API_USER}",
    "PPAP_PG_API_PASSWORD": "${PPAP_PG_API_PASSWORD}",
    "PPAP_S3_ENDPOINT": "${PPAP_S3_ENDPOINT}",
    "PPAP_S3_REGION": "${PPAP_S3_REGION}",
    "PPAP_S3_BUCKET": "${PPAP_S3_BUCKET}",
    "PPAP_S3_ACCESS_KEY": "${PPAP_S3_ACCESS_KEY}",
    "PPAP_S3_SECRET_KEY": "${PPAP_S3_SECRET_KEY}",
    "PPAP_WEB_URL": "${PPAP_WEB_URL}",
    "PPAP_PUBLIC_API_URL": "${PPAP_PUBLIC_API_URL}",
    "LLM_BASE_URL": "${LLM_BASE_URL}",
    "LLM_MODEL": "${LLM_MODEL}",
    "LLM_API_KEY": "${LLM_API_KEY:-}",
    "FEISHU_APP_ID": "${FEISHU_APP_ID:-}",
    "FEISHU_APP_SECRET": "${FEISHU_APP_SECRET:-}",
    "FEISHU_VERIFICATION_TOKEN": "${FEISHU_VERIFICATION_TOKEN:-}",
    "FEISHU_AI_ITEM_ID": "${FEISHU_AI_ITEM_ID:-}",
    "FEISHU_FREE_TRIAL_QUOTA_POINTS": "${FEISHU_FREE_TRIAL_QUOTA_POINTS:-10000}",
    "PPAP_PARTNER_AI_ENDPOINT": "${PPAP_PARTNER_AI_ENDPOINT:-}",
    "LOG_FORMAT": "json",
    "LOG_LEVEL": "INFO"
  }
}
