{
  "name": "ppap-worker",
  "kind": "custom-compute",
  "image": "ppap-worker:${PPAP_BUILD_SHA}",
  "memory_mb": 2048,
  "ingress": "none",
  "environment": {
    "PPAP_PROFILE": "production",
    "PPAP_BUILD_SHA": "${PPAP_BUILD_SHA}",
    "PPAP_SERVICE": "worker",
    "PPAP_PG_HOST": "${PPAP_PG_HOST}",
    "PPAP_PG_PORT": "${PPAP_PG_PORT}",
    "PPAP_PG_DATABASE": "${PPAP_PG_DATABASE}",
    "PPAP_PG_WORKER_USER": "${PPAP_PG_WORKER_USER}",
    "PPAP_PG_WORKER_PASSWORD": "${PPAP_PG_WORKER_PASSWORD}",
    "PPAP_S3_ENDPOINT": "${PPAP_S3_ENDPOINT}",
    "PPAP_S3_REGION": "${PPAP_S3_REGION}",
    "PPAP_S3_BUCKET": "${PPAP_S3_BUCKET}",
    "PPAP_S3_ACCESS_KEY": "${PPAP_S3_ACCESS_KEY}",
    "PPAP_S3_SECRET_KEY": "${PPAP_S3_SECRET_KEY}",
    "PPAP_WEB_URL": "${PPAP_WEB_URL}",
    "LLM_BASE_URL": "${LLM_BASE_URL}",
    "LLM_MODEL": "${LLM_MODEL}",
    "LLM_API_KEY": "${LLM_API_KEY:-}",
    "OCR_ADAPTER_MODE": "${OCR_ADAPTER_MODE:-auto}",
    "OCR_ENGINE": "${OCR_ENGINE:-easyocr}",
    "OCR_LANGUAGES": "${OCR_LANGUAGES:-ch_sim,en}",
    "OCR_OPENAI_API_KEY": "${OCR_OPENAI_API_KEY:-}",
    "OCR_OPENAI_BASE_URL": "${OCR_OPENAI_BASE_URL:-}",
    "OCR_MODEL_NAME": "${OCR_MODEL_NAME:-}",
    "PADDLE_OCR_URL": "${PADDLE_OCR_URL:-}",
    "PADDLE_TOKEN": "${PADDLE_TOKEN:-}",
    "LOG_FORMAT": "json",
    "LOG_LEVEL": "INFO"
  }
}
