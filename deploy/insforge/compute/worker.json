{
  "name": "ppap-worker",
  "kind": "custom-compute",
  "image": "ppap-worker:${PPAP_BUILD_SHA}",
  "memory_mb": 2048,
  "ingress": "none",
  "environment": {
    "PPAP_PROFILE": "production",
    "PPAP_BUILD_SHA": "${PPAP_BUILD_SHA}",
    "PPAP_SERVICE": "worker",
    "PPAP_PG_HOST": "${PPAP_PG_HOST}",
    "PPAP_PG_PORT": "${PPAP_PG_PORT}",
    "PPAP_PG_DATABASE": "${PPAP_PG_DATABASE}",
    "PPAP_PG_WORKER_USER": "${PPAP_PG_WORKER_USER}",
    "PPAP_PG_WORKER_PASSWORD": "${PPAP_PG_WORKER_PASSWORD}",
    "PPAP_S3_ENDPOINT": "${PPAP_S3_ENDPOINT}",
    "PPAP_S3_REGION": "${PPAP_S3_REGION}",
    "PPAP_S3_BUCKET": "${PPAP_S3_BUCKET}",
    "PPAP_S3_ACCESS_KEY": "${PPAP_S3_ACCESS_KEY}",
    "PPAP_S3_SECRET_KEY": "${PPAP_S3_SECRET_KEY}",
    "PPAP_WEB_URL": "${PPAP_WEB_URL}",
    "PPAP_MODEL_TEXT_BASE_URL": "${PPAP_MODEL_TEXT_BASE_URL}",
    "PPAP_MODEL_TEXT_MODEL": "${PPAP_MODEL_TEXT_MODEL}",
    "PPAP_MODEL_TEXT_API_KEY": "${PPAP_MODEL_TEXT_API_KEY:-}",
    "PPAP_MODEL_VISION_API_KEY": "${PPAP_MODEL_VISION_API_KEY:-}",
    "PPAP_MODEL_VISION_BASE_URL": "${PPAP_MODEL_VISION_BASE_URL:-}",
    "PPAP_MODEL_VISION_MODEL": "${PPAP_MODEL_VISION_MODEL:-}",
    "PPAP_MODEL_VISION_EXTRA_BODY_JSON": "${PPAP_MODEL_VISION_EXTRA_BODY_JSON:-}",
    "LOG_FORMAT": "json",
    "LOG_LEVEL": "INFO"
  }
}
