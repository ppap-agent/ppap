# PPAP services on a self-hosted InsForge cluster.
# Not isolated-dev credentials, and not a production secret store.
# PostgreSQL is InsForge's `postgres` service on `insforge-network`.
# Bootstrap user/password must match InsForge POSTGRES_USER / POSTGRES_PASSWORD.
PPAP_PROFILE=production
PPAP_PG_HOST=postgres
PPAP_PG_PORT=5432
PPAP_PG_DATABASE=ppap
PPAP_PG_BOOTSTRAP_USER=postgres
PPAP_PG_BOOTSTRAP_PASSWORD=
PPAP_PG_MIGRATOR_USER=ppap_migrator
PPAP_PG_MIGRATOR_PASSWORD=
PPAP_PG_API_USER=ppap_api
PPAP_PG_API_PASSWORD=
PPAP_PG_WORKER_USER=ppap_worker
PPAP_PG_WORKER_PASSWORD=
PPAP_S3_ENDPOINT=http://silo:9000
PPAP_S3_REGION=us-east-1
PPAP_S3_BUCKET=ppap-objects
PPAP_S3_ACCESS_KEY=
PPAP_S3_SECRET_KEY=
PPAP_WEB_URL=http://127.0.0.1:4173
PPAP_PUBLIC_API_URL=http://127.0.0.1:8080
PPAP_WEB_BIND=0.0.0.0
PPAP_MODEL_TEXT_BASE_URL=
PPAP_MODEL_TEXT_MODEL=
PPAP_MODEL_TEXT_API_KEY=
LOG_FORMAT=json
LOG_LEVEL=INFO
